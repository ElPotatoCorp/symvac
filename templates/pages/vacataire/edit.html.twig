{% extends 'base.html.twig' %}

{% block title %}SymVac - Modifier un vacataire{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="mt-4">Modification du vacataire</h1>
        
        {{ form_start(form) }}
        <div class="row">
            <div class="form-error">
                {{ form_errors(form.nom) }}
            </div>
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom) }}
            
            <div class="row mt-4">
                <div class="col">
                    {{ form_row(form.submit) }}
                </div>
                <div class="col d-flex align-items-center">
                    <a href="{{ path('app_vacataire') }}" class="btn btn-secondary">
                        Retour à la liste
                    </a>
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}